@ The temple hall of the Sinjoh Ruins dungeon (MIGRATION_DECISIONS.md 82, 84). Its five sealed
@ doors open as the PLATE count rises, at the thresholds the Regi doors used outside.
@ Generated by build/sinjoh/dungeon_design.py, which also owns the door coordinates.
SinjohRuins_Hall_hns_MapScripts::
	map_script MAP_SCRIPT_ON_LOAD, SinjohRuins_Hall_OnLoad
	.byte 0

SinjohRuins_Hall_OnLoad:
	call_if_ge VAR_PLATECOUNTER, 3, SinjohRuins_Hall_OpenChamber1
	call_if_ge VAR_PLATECOUNTER, 6, SinjohRuins_Hall_OpenChamber2
	call_if_ge VAR_PLATECOUNTER, 9, SinjohRuins_Hall_OpenChamber3
	call_if_ge VAR_PLATECOUNTER, 12, SinjohRuins_Hall_OpenChamber4
	call_if_ge VAR_PLATECOUNTER, 15, SinjohRuins_Hall_OpenChamber5
	end

SinjohRuins_Hall_OpenChamber1:
	setmetatile 5, 3, 0x308, FALSE
	return

SinjohRuins_Hall_OpenChamber2:
	setmetatile 9, 3, 0x308, FALSE
	return

SinjohRuins_Hall_OpenChamber3:
	setmetatile 15, 3, 0x308, FALSE
	return

SinjohRuins_Hall_OpenChamber4:
	setmetatile 21, 3, 0x308, FALSE
	return

SinjohRuins_Hall_OpenChamber5:
	setmetatile 25, 3, 0x308, FALSE
	return
